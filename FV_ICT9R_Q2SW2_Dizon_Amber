<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>OBMC Student Enrollment Form</title>


    
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <style>

        body {
            font-family: Arial, sans-serif;

            margin: 0;

           
            background-image: url("https://images.squarespace-cdn.com/content/v1/636b5e138fd7c9613e2a8b61/c00bb232-be8d-4444-beb0-8382b654c5b7/OBMC+CASA+Classroom.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;

            min-height: 100vh;
        }


       

        .navbar {
            background-color: #191c1f;
        }


        .navbar-brand {
            color: white;
            font-weight: bold;
        }


        .nav-link {
            color: white !important;
        }


        .nav-link:hover {
            color: #e7b724 !important;
        }


     

        .header {
            color: white;
            padding: 25px;
            text-align: center;
        }


       

        .title-logo {
            width: 55px;
            height: 55px;

            object-fit: cover;

            border-radius: 50%;

            margin-right: 12px;
        }


       
        .form-box {
            background-color: rgba(255, 255, 255, 0.88);

            padding: 25px;

            max-width: 700px;

            margin: auto;

            border-radius: 5px;

            box-shadow: 0 5px 15px
                        rgba(0, 0, 0, 0.25);
        }


        .section-title {
            font-weight: bold;
            font-size: 18px;

            margin-top: 10px;
            margin-bottom: 10px;

            color: #333;
        }


       

        .btn-primary {
            background-color: #087ff5;
            border-color: #087ff5;
        }


        .btn-primary:hover {
            background-color: #006bd6;
            border-color: #006bd6;
        }


      

        footer {
            background-color: #212529;

            color: white;

            text-align: center;

            padding: 15px;

            margin-top: 30px;
        }


    </style>

</head>


<body>


  
    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">


           
            <a class="navbar-brand"
               href="#home">

                

                
                <a class="navbar-brand" href="#home">

    <img
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSFRVrtHCA-A2babQFQ6KPMp6Nlbw5cMU_iboO3vnFboA&s=10"
        alt="School Logo"
        width="40"
        height="40"
        style="border-radius: 50%;"
    >

</a>

                    alt="School Logo"

                    width="40"

                    height="40"

                    style="border-radius: 50%;"
                >

            </a>


        

            <button class="navbar-toggler"

                type="button"

                data-bs-toggle="collapse"

                data-bs-target="#myNavbar"
            >

                <span class="navbar-toggler-icon"></span>

            </button>


   

            <div
                class="collapse navbar-collapse"

                id="myNavbar"
            >


                <ul class="navbar-nav me-auto">


                    <li class="nav-item">

                        <a
                            class="nav-link"

                            href="#home"
                        >

                            Home

                        </a>

                    </li>



                    <li class="nav-item">

                        <a
                            class="nav-link"

                            href="#enroll"
                        >

                            Enroll

                        </a>

                    </li>



                    <li class="nav-item">

                        <a
                            class="nav-link"

                            href="#contact"
                        >

                            Contact Us

                        </a>

                    </li>


                </ul>



                <!-- SEARCH BOX -->

                <form
                    class="d-flex"

                    onsubmit="searchPage(event)"
                >


                    <input
                        class="form-control me-2"

                        type="search"

                        id="searchInput"

                        placeholder="Search"
                    >


                   

                    <button class="btn btn-primary"

                        type="submit"
                    >

                        Search

                    </button>


                </form>


            </div>


        </div>


    </nav>



   

    <header
        class="header"

        id="home"
    >


        
        <div
            class="d-flex justify-content-center
                   align-items-center"
        >


           
            <img
                src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSFRVrtHCA-A2babQFQ6KPMp6Nlbw5cMU_iboO3vnFboA&s=10"

                alt="OBMC Logo"

                class="title-logo"
            >


            <h1>

                OBMC Student Enrollment Form

            </h1>


        </div>


        <p>

            Fill out the form below
            to enroll for the upcoming school year.

        </p>


    </header>



  
    <main
        class="container-fluid"

        id="enroll"
    >


        
        <form
            class="form-box"

            id="enrollmentForm"

            onsubmit="submitEnrollment(event)"
        >


            

            <div
                class="section-title"
            >

                Student Information

            </div>



            

            <div
                class="row"
            >


                <div
                    class="col-md-6 mb-3"
                >

                    <label
                        for="firstName"
                    >

                        First Name

                    </label>


                    <br>


                    <input
                        type="text"

                        id="firstName"

                        class="form-control"

                        placeholder="Amber"

                        required
                    >


                </div>



                <div
                    class="col-md-6 mb-3"
                >

                    <label
                        for="lastName"
                    >

                        Last Name

                    </label>


                    <br>


                    <input
                        type="text"

                        id="lastName"

                        class="form-control"

                        placeholder="Dizon"

                        required
                    >


                </div>


            </div>



           

            <div
                class="row"
            >


               

                <div
                    class="col-md-4 mb-3"
                >

                    <label
                        for="birthDate"
                    >

                        Birth Date

                    </label>


                    <br>


                    <input
                        type="date"

                        id="birthDate"

                        class="form-control"

                        required
                    >


                </div>



              

                <div
                    class="col-md-4 mb-3"
                >

                    <label
                        for="gender"
                    >

                        Gender

                    </label>


                    <br>


                    

                    <select
                        id="gender"

                        class="form-select"

                        required
                    >


                        <option value="">

                            Select...

                        </option>


                        <option value="Male">

                            Male

                        </option>


                        <option value="Female">

                            Female

                        </option>


                        <option value="Other">

                            Other

                        </option>


                    </select>


                </div>



               

                <div
                    class="col-md-4 mb-3"
                >

                    <label
                        for="gradeLevel"
                    >

                        Grade Level

                    </label>


                    <br>


                   

                    <select
                        id="gradeLevel"

                        class="form-select"

                        required
                    >


                        <option value="">

                            Select your grade level...

                        </option>


                        <option value="Casa">

                            Casa

                        </option>


                        <option value="Grade 1">

                            Grade 1

                        </option>


                        <option value="Grade 2">

                            Grade 2

                        </option>


                        <option value="Grade 3">

                            Grade 3

                        </option>


                        <option value="Grade 4">

                            Grade 4

                        </option>


                        <option value="Grade 5">

                            Grade 5

                        </option>


                        <option value="Grade 6">

                            Grade 6

                        </option>


                        <option value="Grade 7">

                            Grade 7

                        </option>


                        <option value="Grade 8">

                            Grade 8

                        </option>


                        <option value="Grade 9">

                            Grade 9

                        </option>


                        <option value="Grade 10">

                            Grade 10

                        </option>


                        <option value="Grade 11">

                            Grade 11

                        </option>


                        <option value="Grade 12">

                            Grade 12

                        </option>


                    </select>


                </div>


            </div>



           
            <div
                class="section-title"
            >

                Contact Details

            </div>



            

            <div
                class="mb-3"
            >

                <label
                    for="email"
                >

                    Email Address

                </label>


                <br>


                <input
                    type="email"

                    id="email"

                    class="form-control"

                    placeholder="amberdizon@gmail.com"

                    required
                >


            </div>



            

            <div
                class="mb-3"
            >

                <label
                    for="contactNumber"
                >

                    Contact Number

                </label>


                <br>


                <input
                    type="tel"

                    id="contactNumber"

                    class="form-control"

                    placeholder="0912-345-6789"

                    required
                >


            </div>



           
            <div
                class="section-title"
            >

                Other Information

            </div>


  

            <p>

                Mode of Learning

            </p>



            

            <input
                type="radio"

                id="online"

                name="learningMode"

                value="Online"

                required
            >


            <label
                for="online"
            >

                Online

            </label>


            <br>



            

            <input
                type="radio"

                id="faceToFace"

                name="learningMode"

                value="Face-to-Face"
            >


            <label
                for="faceToFace"
            >

                Face-to-Face

            </label>


            <br>
            <br>



            

            <input
                type="checkbox"

                id="confirmation"

                required
            >


            <label
                for="confirmation"
            >

                I confirm that the information provided
                is true and complete.

            </label>


            <br>
            <br>



            
            <div
                class="text-center"
            >

                <button
                    type="submit"

                    class="btn btn-primary"
                >

                    Submit Enrollment

                </button>


            </div>


        </form>


    </main>



    

    <section
        class="container text-center text-white mt-4"

        id="contact"
    >


        <h2>

            Contact Us

        </h2>


        <p>

            Email:
            admissions_fv@obmontessori.edu.ph

        </p>


    </section>



   

    <footer>


        <p class="mb-0">

            &copy; 2026 OBMC School Website.
            All Rights Reserved.

        </p>


    </footer>



    
    <script>


        /* SEARCH BUTTON FUNCTION */

        function searchPage(event) {

            event.preventDefault();


            var searchText =
                document
                .getElementById("searchInput")
                .value;


            if (searchText == "") {

                alert(
                    "Please type something to search."
                );

            }

            else {

                alert(
                    "You searched for: "
                    + searchText
                );

            }

        }



       

        function submitEnrollment(event) {

            event.preventDefault();


            var firstName =
                document
                .getElementById("firstName")
                .value;


            alert(

                "Thank you, "
                + firstName
                + "! Your enrollment form has been submitted."

            );

        }


    </script>



    

    <script>
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    >
    </script>


</body>

</html>